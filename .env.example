# Local-only development secret template. Copy to `.env.local`, keep that file
# mode 0600, and never commit, paste, or print its value.
GLM_API_KEY=replace_with_secret_manager_or_local_secret
FMP_API_KEY=replace_with_secret_manager_or_local_secret
# Optional read-only fallback to the existing FMP-backed valuation snapshots.
KRW_MARKET_SNAPSHOT_STORE_URL=https://your-project.supabase.co
KRW_MARKET_SNAPSHOT_STORE_SERVICE_ROLE_KEY=replace_with_secret_manager_or_local_secret
